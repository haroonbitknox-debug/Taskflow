APP_ENV=development
APP_TIMEZONE=UTC
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_BASE_URL=http://localhost:5173
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
UPLOAD_STORAGE_DIR=uploads/user-files
FILE_MAX_SIZE_BYTES=10485760
FILE_MAX_ROWS=20000
FILE_MAX_COLUMNS=100
FILE_MAX_WORKSHEETS=20
FILE_MAX_PROCESSING_SECONDS=30
FILE_MAX_EXTRACTED_TEXT_BYTES=10485760
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_TOKENS=1200
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true
MAIL_USE_SSL=false
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_REQUEST_LIMIT=3
PASSWORD_RESET_REQUEST_WINDOW_MINUTES=60
PASSWORD_RESET_VERIFY_LIMIT=30
PASSWORD_RESET_VERIFY_WINDOW_MINUTES=15
